# 数据库类型配置
# 支持: postgresql, duckdb
DATABASE=duckdb

# PostgreSQL 数据库连接字符串 (当 DATABASE=postgresql 时使用)
POSTGRES_DB_URL=postgresql://postgres:postgres@localhost:5432/financial_statements

# PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=financial
DB_USER=postgres
DB_PASSWORD=


# DuckDB 数据库文件路径 (当 DATABASE=duckdb 时使用)
DUCKDB_DB_PATH=./data/db/financial_data.duckdb

# ==================== LLM 配置 ====================

# LLM 模型标识 (格式: provider/model_name)
MODEL=openai/gpt-4o

# LLM API Key (必需)
API_KEY=your-api-key-here

# LLM API 基础 URL (可选，用于自定义端点或私有部署)
# 留空则使用提供商默认 URL
API_BASE=""
